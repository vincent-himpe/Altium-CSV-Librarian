<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, single-file publish profile.
  Produces one CsvLibrarian.exe with the .NET 8 runtime bundled in — no runtime
  install required on the target machine.

  Visual Studio 2022:  right-click project → Publish → this profile.
  CLI:  dotnet publish CsvLibrarian\CsvLibrarian.vbproj -p:PublishProfile=SelfContained-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WinForms uses reflection heavily; trimming is unsafe, so leave it off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No separate .pdb — ship a single .exe. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
